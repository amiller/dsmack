# Spike agent for an x86 docker host: the Claude Code 2.1.187 CLI under tmux, served by ptyd.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends tmux python3 && rm -rf /var/lib/apt/lists/* \
 && npm install -g @anthropic-ai/claude-code@2.1.187 && npm cache clean --force
COPY ptyd.py /opt/ptyd.py
USER node
RUN mkdir -p /home/node/.claude/projects /home/node/work && echo '{"hasCompletedOnboarding":true}' > /home/node/.claude/.claude.json
ENV CLAUDE_CONFIG_DIR=/home/node/.claude DISABLE_AUTOUPDATER=1 CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 TERM=xterm-256color
WORKDIR /home/node/work
ENTRYPOINT ["python3", "/opt/ptyd.py", "7000", "tmux", "new", "-A", "-s", "main", "claude"]
