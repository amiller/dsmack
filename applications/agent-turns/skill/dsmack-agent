MAC_RUN = r'''set -euo pipefail
D=$HOME/$1; T=$D/t/$2; R=$D/runner; N=run-agent-turn-$2
[ "$(df -k "$D" | tail -1 | awk '{print $4}')" -gt 12582912 ] || { echo 'the Mac needs 12 GiB free' >&2; exit 3; }
# Other runner VMs (the Layover guests, the pools) may run; refuse only another turn.
! pgrep -f "$D/t/.*/session.json" >/dev/null || { echo 'another agent turn is running on the Mac' >&2; exit 3; }
