# doctor: each check prints `ok <name>` or `FAIL <name>: <reason>`; nothing secret is printed.
MAC_CHECKS = r'''
import hashlib,json,os,shutil,stat,subprocess,sys
from pathlib import Path
a=json.loads(sys.argv[1]);h=Path.home();d=h/a['dir'];r=d/'runner'
def sha(p):
 x=hashlib.sha256()
 with open(p,'rb') as f:
  for c in iter(lambda:f.read(1<<20),b''):x.update(c)
 return x.hexdigest()
def c(name,f):
 try:v=f()
 except Exception as e:v='%s %s'%(type(e).__name__,e)
 print('ok '+name if v is None else 'FAIL %s: %s'%(name,v),flush=True)
want=lambda got,exp:None if got==exp else 'got %s'%got
c('runner CDHash',lambda:None if 'CandidateCDHashFull sha256='+a['cdhash'] in subprocess.run(['codesign','-d','--verbose=4',str(r/'DsmackRunner.app')],capture_output=True,text=True).stderr else 'mismatch')
c('base is OS_IMAGE',lambda:want(sha(r/'base/sha256sum.txt'),a['os_image']))
c('base files match sha256sum.txt',lambda:subprocess.run(['shasum','-a','256','-c','--quiet','sha256sum.txt'],cwd=r/'base',capture_output=True,check=True) and None)
c('enrollment present',lambda:None if all((r/'enrollment'/n).is_file() for n in ('attestation.cbor','clientData.bin','keyId.txt')) else 'missing')
cmd=dict(x.split('=',1) for x in json.loads((r/'base/metadata.json').read_bytes())['cmdline'].split() if '=' in x)
for n in ('scratch','result'):c('runtime %s template'%n,lambda:want(sha(r/'runtime/base'/(n+'-template.ext4')),cmd['dstack.%s_template_sha256'%n]))
c('runtime gvproxy',lambda:None if os.access(r/'runtime/helper/gvproxy-darwin',os.X_OK) else 'missing')
c('workload manifest is MANIFEST',lambda:want(sha(d/'workload/compose-manifest.json'),a['manifest']))
c('workload disk is WORKLOAD',lambda:want(sha(d/'workload/workload.img'),a['workload']))
def token():
 s=os.lstat(h/a['credential'])
 if not stat.S_ISREG(s.st_mode) or stat.S_IMODE(s.st_mode)!=0o600:return 'not a 0600 regular file'
 return None if (h/a['credential']).read_bytes().startswith(b'sk-ant-oat01-') else 'not a setup token'
c('setup token present',token)
c('pool dirs present',lambda:None if all((h/p).is_dir() for p in a['pools']) else 'missing')
c('12 GiB free',lambda:None if shutil.disk_usage(d).free>12<<30 else '%d GiB'%(shutil.disk_usage(d).free>>30))
c('no agent turn running',lambda:None if subprocess.run(['pgrep','-f',str(d/'t')+'/.*/session.json'],capture_output=True).returncode==1 else 'running')
'''


def doctor(args):
    """Check, without launching anything, everything run needs."""
    lines = [f'{"ok" if MAC else "FAIL"} env DSMACK_MAC_HOST',
             'ok debugfs' if Path('/sbin/debugfs').exists() else 'FAIL debugfs: /sbin/debugfs missing']
    if MAC:
        params = {'dir': MAC_DIR, 'cdhash': CDHASH, 'os_image': OS_IMAGE, 'manifest': MANIFEST, 'workload': WORKLOAD,
                  'credential': CREDENTIAL, 'pools': POOLS}
        p = subprocess.run(['ssh', MAC, 'python3 -I - ' + shlex.quote(json.dumps(params))], input=MAC_CHECKS, capture_output=True, text=True)
        lines += p.stdout.splitlines() or [f'FAIL {MAC} reachable: ssh exit {p.returncode}']
    print('\n'.join(lines))
    sys.exit(any(l.startswith('FAIL') for l in lines))


def snapshot(repo, inputs):
    names = subprocess.run(['git', '-C', str(repo), 'ls-files', '-z', '-co', '--exclude-standard', '--deduplicate'],
                           check=True, capture_output=True).stdout.decode().split('\0')
    for name in filter(None, names):
        find.require(not (repo/name).is_symlink(), f'{name} is a symlink; a turn takes regular files only')
        if os.path.lexists(repo/name):
            (inputs/name).parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(repo/name, inputs/name, follow_symlinks=False)
    size = sum(p.stat().st_size for p in inputs.rglob('*') if p.is_file())
    find.require(size <= MAX_INPUTS, f'snapshot is {size} bytes; the limit is {MAX_INPUTS}')
    return find.tree_digest(inputs)


def ssh(host, command, **kw):
    return subprocess.run(['ssh', host, command], check=True, **kw)


def mac(request, inputs, out):
    """Run the turn on the Mac. Returns the checked turn record."""
    run_id = uuid.uuid4().hex[:12]
    t = f'{MAC_DIR}/t/{run_id}'
    ssh(MAC, f'mkdir -m700 -p {t} && tar -x -C {t}', input=bundle(request, inputs))
    try:
        ssh(MAC, f'bash -s {MAC_DIR} {run_id} {CREDENTIAL} "{" ".join(POOLS)}"', input=MAC_RUN.encode())
    finally:
        # inputs.img holds the credential.
        ssh(MAC, f'rm -f {t}/inputs.img {t}/workload.img')
    try:
        # The VM has exited once open -W returns; its staged disks and 4 GiB scratch stay behind.
        pulled = ssh(MAC, f'tar -czh --exclude "*.staged" --exclude scratch.img -C {t} out stdout.txt stderr.txt session.json '
                          f'-C ../.. workload/compose-manifest.json runner/enrollment', capture_output=True).stdout
    finally:
        ssh(MAC, f'rm -rf {t}')
    with tarfile.open(fileobj=io.BytesIO(pulled)) as tar:
        tar.extractall(out, filter='data')
    (out/'result').mkdir()
    subprocess.run(['/sbin/debugfs', '-R', f'rdump / {out/"result"}', str(out/'out/result.img')], check=True, capture_output=True)
    subprocess.run(['gzip', str(out/'out/result.img')], check=True)
    shutil.copytree(out/'result'/SELECTOR/'outputs/artifacts', out/'artifacts')
    return turn.from_guest_attest((out/'artifacts/attestation').read_bytes(), request, out/'artifacts', out/'out',
                                  out/'runner/enrollment', CDHASH, OS_IMAGE, MANIFEST)


def bundle(request, inputs):
    """A tar of request.json, tree.tar (the snapshot as the turn's `tree` slot) and the helpers the Mac runs."""
    tree = io.BytesIO()
    with tarfile.open(fileobj=tree, mode='w', format=tarfile.USTAR_FORMAT) as tar:
        for path in sorted(p for p in inputs.rglob('*') if p.is_file()):
            tar.add(path, str(path.relative_to(inputs)))
    raw = io.BytesIO()
    with tarfile.open(fileobj=raw, mode='w') as tar:
        files = [('request.json', request), ('tree.tar', tree.getvalue())]
        files += [('helpers/' + name, path.read_bytes()) for name, path in HELPERS.items()]
        for name, body in files:
            info = tarfile.TarInfo(name)
            info.size = len(body)
            tar.addfile(info, io.BytesIO(body))
    return raw.getvalue()


def run(args):
    find.require(MAC, 'set DSMACK_MAC_HOST (README.md, Dispatch to the Mac)')
    repo, out = args.repo.resolve(), args.out.resolve()
    out.mkdir(parents=True)
    (out/'inputs').mkdir()
    agent = {'cli_version': CLI_VERSION, 'cli_sha256': CLI_SHA256,
             'model': args.model, 'tools': args.tools.split(','), 'max_turns': args.max_turns,
             'wall_seconds': args.wall_seconds, 'settings': {'disableAllHooks': True}}
    request = turn.canonical({'schema': 'dsmack-agent-turn/1', 'agent': agent, 'prompt': args.prompt,
                              'inputs_sha256': snapshot(repo, out/'inputs'), 'state_in': None})
    (out/'request.json').write_bytes(request)
    print('out:', out, file=sys.stderr)
    record = mac(request, out/'inputs', out)
    (out/'turn.json').write_text(json.dumps(record, indent=2))
    patch = out/'artifacts'/'patch'
    subprocess.run(['git', '-C', str(repo), 'apply', '--check', str(patch)], check=True)
    print(patch)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(required=True)
    p = sub.add_parser('run', help='dispatch one coding turn to the Mac')
    p.add_argument('--repo', type=Path, required=True, help='git checkout; its working tree is the input')
    p.add_argument('--prompt', required=True)
    p.add_argument('--out', type=Path, required=True, help='new local directory for the request and artifacts')
    p.add_argument('--tools', default='Read,Grep,Glob,Edit,Write')
    p.add_argument('--model', default='claude-opus-4-8')
    p.add_argument('--max-turns', type=int, default=30)
    p.add_argument('--wall-seconds', type=int, default=480)
    p.set_defaults(func=run)
    sub.add_parser('doctor', help='check the Mac for run without launching').set_defaults(func=doctor)
    args = parser.parse_args()
    args.func(args)


if __name__ == '__main__':
    main()
