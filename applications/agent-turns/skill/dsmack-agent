 'private_input_path':str(t/'inputs.img'),'net_socket_path':str(t/'net.sock'),**tpl('scratch'),**tpl('result')}))
net=subprocess.Popen([str(rt/'helper/gvproxy-darwin'),'-listen-qemu','unix://%s'%(t/'net.sock'),'-ssh-port','-1','-log-file',str(t/'gvproxy.log')])
