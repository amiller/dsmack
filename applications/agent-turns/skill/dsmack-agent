#!/usr/bin/env python3
"""dsmack-agent run: hand a coding task on a git checkout to the pinned agent and get back a patch.

The working tree is snapshotted and sent with a dsmack-agent-turn/1 request to the attested Mac. The Mac writes a
private input disk with the request, the snapshot and its Claude setup token, and boots the agent-turns workload
(mac.py) once on the pinned runner and base image. In the guest the agent's model calls go through the compose's
sentinel service, which alone holds the token. The workload signs its results with the guest Attest, and
turn.from_guest_attest checks that here. No operator host or coordinator takes part in a turn.
"""
import argparse
import io
import json
import os
from pathlib import Path
import shlex
import shutil
import subprocess
import sys
import tarfile
import uuid

TURNS = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(TURNS))
import find
import turn

CLI_VERSION, CLI_SHA256 = '2.1.187', 'b49be8a5e565bf2d45b50d2de62017b25462131acc9425d2fdb98b8f29c9dce2'
# The snapshot tar travels base64-encoded in a private env value; the guest caps all env values at 1 MiB in total.
MAX_INPUTS = 640 << 10
MAC = os.environ.get('DSMACK_MAC_HOST')
SELECTOR = 'agent-turns-edit-v1'
# On the Mac, ~/MAC_DIR holds runner/ (DsmackRunner.app, enrollment/, runtime/ with the disk templates and gvproxy,
# base/) and workload/ (workload.img and compose-manifest.json from mac.py workload, image sha256:d4fcf41e…); turns run in t/<id>.
MAC_DIR = 'dsmack-agent-turns-20261121'
CDHASH = '0c3d3c90bb26fa01d01aff1fba61f83d395bc8e2df29d2ec5b95acff2c75969f'
OS_IMAGE = '8783a3bea61a43f48b5b625667ca49784975b0e8d908d4d3b0890d0867bf6030'
MANIFEST = 'cd747238c3cfadbf9da00cce304c219f40d87fcacb80c6d49a2ca8e34104dcd4'
WORKLOAD = '414aad9924caf6191623abd57fa23a423f8f36a66320064a01bc4158e4f5642b'
# The one-year inference-only token from `claude setup-token`, mode 0600.
CREDENTIAL = '.dsmack/private-inputs/claude-oauth-token'
# The Mac's compute pools pause while a runner VM runs whose session.json they cannot see under a run-* dir of
# their --coexist-pool dirs; Layover's run-mini.sh links its guests into the same two state dirs.
POOLS = ('ds', 'dl')
# Sent with every turn, so the Mac keeps no copy that can drift.
HELPERS = {'export_subscription.py': TURNS.parent/'pilot-client/workload/export_subscription.py',
           'reference/claude_subscription_document.py': TURNS.parent/'pilot-client/workload/reference/claude_subscription_document.py',
           'private_inputs.py': TURNS/'private_inputs.py'}

