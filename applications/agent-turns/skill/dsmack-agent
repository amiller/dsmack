def snapshot(repo, inputs):
    names = subprocess.run(['git', '-C', str(repo), 'ls-files', '-z', '-co', '--exclude-standard', '--deduplicate'],
                           check=True, capture_output=True).stdout.decode().split('\0')
    for name in filter(None, names):
        find.require(not (repo/name).is_symlink(), f'{name} is a symlink; a turn takes regular files only')
        if os.path.lexists(repo/name):
            (inputs/name).parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(repo/name, inputs/name, follow_symlinks=False)
    size = sum(p.stat().st_size for p in inputs.rglob('*') if p.is_file())
    find.require(size <= MAX_INPUTS, f'snapshot is {size} bytes; the Mac projection limit is {MAX_INPUTS}')
    return find.tree_digest(inputs)


def ssh(host, command, **kw):
    return subprocess.run(['ssh', host, command], check=True, **kw)


def mac(request, inputs, out):
    """Run the turn in the signed release's guest on the Mac. Returns the turn record of the verified receipt v4."""
    run_id = uuid.uuid4().hex[:12]
    op = f'{OPERATOR_DIR}/attempts/{run_id}'
    ssh(OPERATOR, f'mkdir -p {op} && tar -x -C {op}', input=bundle(request, inputs))
    admitted = ssh(OPERATOR, f'cd {OPERATOR_DIR} && . ./coordinator.env && python3 -B source/applications/agent-turns/mac.py admit --release {RELEASE} '
                        f'--oci {IMAGE}/oci-layout --authority authority --request {op}/request.json '
                        f'--inputs-tar {op}/tree.tar --out {op}/admit', capture_output=True).stdout
    admission = json.loads(admitted.splitlines()[-1])
    attempt = admission['attempt_id']
    (out/'admission.json').write_bytes(admitted.splitlines()[-1])
    fetch(f'{op}/admit', ADMITTED, f'{MAC_DIR}/t/{run_id}', admission['workload_disk']['sha256'])
    evidence = f'{MAC_DIR}/r/attempt-{attempt}'
    try:
        ssh(MAC, f'bash -s {MAC_DIR} {run_id} {CREDENTIAL}', input=MAC_RUN.encode())
        pipe(f'tar -c --exclude scratch.img --exclude "*.staged" -C {evidence} .', f'mkdir {op}/evidence && tar -x -C {op}/evidence')
    finally:
        # The VM has exited once execute returns; its two 4 GiB scratch copies are the run's only large residue.
        # private-input.img holds the credential.
        # A launch that failed before prepare has no evidence dir.
        ssh(MAC, f'rm -rf {MAC_DIR}/t/{run_id}/private {MAC_DIR}/t/{run_id}/tmp {MAC_DIR}/t/{run_id}/workload.img; '
                 f'[ ! -d {evidence} ] || {{ cd {evidence} && ! /usr/sbin/lsof -- scratch.img scratch-template.img.staged '
                 f'&& rm -f scratch.img *.staged; }}')
    result = ssh(OPERATOR, f'cd {OPERATOR_DIR} && . ./coordinator.env && python3 -B source/applications/agent-turns/mac.py verify --authority authority '
                      f'--attempt {op}/admit --evidence {op}/evidence --job {op}/verify', capture_output=True).stdout
    (out/'verification.json').write_bytes(result.splitlines()[-1])
    pulled = ssh(OPERATOR, f'tar -c -C {op}/verify/retained receipt.json report.json -C outputs artifacts', capture_output=True).stdout
    with tarfile.open(fileobj=io.BytesIO(pulled)) as tar:
        tar.extractall(out, filter='data')
    return turn.from_receipt(json.loads((out/'receipt.json').read_bytes()), request, out/'artifacts')


def mac_v02(request, inputs, out):
    """Run the turn on the v0.2.0-canary.1 runner and base image on the Mac. Returns the checked turn record."""
    run_id = uuid.uuid4().hex[:12]
    op, mac_t = f'{V02_OPERATOR_DIR}/attempts/{run_id}', f'{V02_MAC_DIR}/t/{run_id}'
    ssh(OPERATOR, f'mkdir -p {op} && tar -x -C {op}', input=bundle(request, inputs))
    admitted = ssh(OPERATOR, f'cd {V02_OPERATOR_DIR} && . {OPERATOR_DIR}/coordinator.env && python3 -B source/applications/agent-turns/mac.py admit-v02 '
                        f'--release {OPERATOR_DIR}/{RELEASE} --base base --oci {V02_IMAGE}/oci-layout --request {op}/request.json '
                        f'--inputs-tar {op}/tree.tar --out {op}/admit', capture_output=True).stdout
    admission = json.loads(admitted.splitlines()[-1])
    (out/'admission.json').write_bytes(admitted.splitlines()[-1])
    fetch(f'{op}/admit', 'workload.img preparation closure-context.json', mac_t, admission['workload_disk']['sha256'])
    ssh(OPERATOR, f'rm {op}/admit/workload.img {op}/tree.tar')
    try:
        ssh(MAC, f'bash -s {V02_MAC_DIR} {run_id} {CREDENTIAL}', input=MAC_RUN_V02.encode())
    finally:
        # private-input.img holds the credential.
        ssh(MAC, f'rm -rf {mac_t}/private {mac_t}/tmp {mac_t}/workload.img')
    try:
        # The VM has exited once open -W returns; its staged disks and 4 GiB scratch stay behind.
        pulled = ssh(MAC, f'tar -cz --exclude "*.staged" --exclude scratch.img -C {mac_t} '
                          f'out stage.json stdout.txt stderr.txt session.json -C ../.. enrollment', capture_output=True).stdout
    finally:
        ssh(MAC, f'rm -rf {mac_t}')
    with tarfile.open(fileobj=io.BytesIO(pulled)) as tar:
        tar.extractall(out, filter='data')
    (out/'result').mkdir()
    subprocess.run(['/sbin/debugfs', '-R', f'rdump / {out/"result"}', str(out/'out/result.img')], check=True, capture_output=True)
    subprocess.run(['gzip', str(out/'out/result.img')], check=True)
    shutil.copytree(out/'result'/SELECTOR/'outputs/artifacts', out/'artifacts')
    return turn.from_guest_attest((out/'artifacts/attestation').read_bytes(), request, out/'artifacts', out/'out',
                                  out/'enrollment', V02_CDHASH, V02_OS_IMAGE, admission['manifest_sha256'])


def bundle(request, inputs):
    """A tar of request.json and tree.tar, the snapshot as the turn's `tree` slot."""
    tree = io.BytesIO()
    with tarfile.open(fileobj=tree, mode='w', format=tarfile.USTAR_FORMAT) as tar:
        for path in sorted(p for p in inputs.rglob('*') if p.is_file()):
            tar.add(path, str(path.relative_to(inputs)))
    raw = io.BytesIO()
    with tarfile.open(fileobj=raw, mode='w') as tar:
        for name, body in (('request.json', request), ('tree.tar', tree.getvalue())):
            info = tarfile.TarInfo(name)
            info.size = len(body)
            tar.addfile(info, io.BytesIO(body))
    return raw.getvalue()


def fetch(src, names, dst, disk_sha256):
    """The operator host serves `names` under src over HTTP; the Mac fetches them into dst and checks each file's sha256."""
    sums = ssh(OPERATOR, f'cd {src} && find {names} -type f -print0 | xargs -0 sha256sum', capture_output=True, text=True).stdout
    find.require(f'{disk_sha256}  workload.img\n' in sums, 'the operator\'s workload.img is not the admitted disk')
    curl = ' '.join(f'-o {shlex.quote(p)} http://{FETCH_ADDR}:{FETCH_PORT}/{quote(p)}' for p in (l.split('  ', 1)[1] for l in sums.splitlines()))
    server = subprocess.Popen(['ssh', OPERATOR, f'cd {src} && echo $$ && exec timeout 900 python3 -u -m http.server {FETCH_PORT} --bind {FETCH_ADDR}'],
                              stdout=subprocess.PIPE, text=True)
    pid = server.stdout.readline().strip()
    try:
        find.require(server.stdout.readline().startswith('Serving HTTP'), 'the operator host did not start its file server')
        ssh(MAC, f'mkdir -m700 -p {dst} && cd {dst} && curl -fsS --create-dirs {curl} && shasum -a 256 -c --quiet && chmod -R go-rwx .',
            input=sums.encode())
    finally:
        ssh(OPERATOR, f'kill {pid}')
        server.wait()


def pipe(source, sink, src=MAC, dst=OPERATOR):
    """Stream a tar from one host to another through this machine."""
    reader = subprocess.Popen(['ssh', src, source], stdout=subprocess.PIPE)
    subprocess.run(['ssh', dst, sink], stdin=reader.stdout, check=True)
    assert reader.wait() == 0, f'{src}: {source}'


def run(args):
    repo, out = args.repo.resolve(), args.out.resolve()
    out.mkdir(parents=True)
    (out/'inputs').mkdir()
    agent = {'cli_version': CLI_VERSION, 'cli_sha256': CLI_SHA256,
             'model': args.model, 'tools': args.tools.split(','), 'max_turns': args.max_turns,
             'wall_seconds': args.wall_seconds, 'settings': {'disableAllHooks': True}}
    request = turn.canonical({'schema': 'dsmack-agent-turn/1', 'agent': agent, 'prompt': args.prompt,
                              'inputs_sha256': snapshot(repo, out/'inputs'), 'state_in': None})
    (out/'request.json').write_bytes(request)
    print('out:', out, file=sys.stderr)
    record = args.transport(request, out/'inputs', out)
    (out/'turn.json').write_text(json.dumps(record, indent=2))
    patch = out/'artifacts'/'patch'
    subprocess.run(['git', '-C', str(repo), 'apply', '--check', str(patch)], check=True)
    print(patch)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(required=True)
    add_run(sub.add_parser('run', help='dispatch one coding turn to the alpha release'), mac)
    add_run(sub.add_parser('run-v02', help='dispatch one coding turn to the v0.2.0-canary.1 runner'), mac_v02)
    args = parser.parse_args()
    args.func(args)


def add_run(p, transport):
    p.add_argument('--repo', type=Path, required=True, help='git checkout; its working tree is the input')
    p.add_argument('--prompt', required=True)
    p.add_argument('--out', type=Path, required=True, help='new local directory for the request and artifacts')
    p.add_argument('--tools', default='Read,Grep,Glob,Edit,Write')
    p.add_argument('--model', default='claude-opus-4-8')
    p.add_argument('--max-turns', type=int, default=30)
    p.add_argument('--wall-seconds', type=int, default=480)
    p.set_defaults(func=run, transport=transport)


if __name__ == '__main__':
    main()
