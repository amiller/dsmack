(t/'session.json').write_bytes(canon({'schema':'dsmack-general-launcher/session/3','policy_path':str(t/'policy.json'),'image_manifest_path':str(t/'image-manifest.json'),
 'checksum_manifest_path':str(b/'sha256sum.txt'),'metadata_path':str(b/'metadata.json'),'admission_path':str(t/'admission.json'),
