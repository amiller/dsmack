python3 -I -B helpers/export_subscription.py --source "$HOME/$3" --emit-credential-stdout | \
  python3 -I -B helpers/private_inputs.py $D/workload/compose-manifest.json inputs.img request.json tree.tar
cp -c $D/workload/workload.img workload.img
