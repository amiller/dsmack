meta=json.loads((b/'metadata.json').read_bytes());osh=fsha(b/'sha256sum.txt');args=dict(x.split('=',1) for x in meta['cmdline'].split() if '=' in x)
image={'schema':'dsmack-general-launcher/image-manifest/1','arch':'aarch64','description':'agent turns','image_id':osh,'cmdline':meta['cmdline'],
 'guest':{'console':'hvc0','scratch_device':'vdb','workload_device':'vdc','supervisor_markers':'DSMACK_RESULT_CLOSED_V1'},
 'kernel':desc(b/'Image'),'initrd':desc(b/'initramfs.cpio.gz'),'system_disk':dict(desc(b/'rootfs.squashfs.verity'),format='raw',verity_root_hash=args['dstack.rootfs_hash']),
 'resource_profiles':{'mini-4096':{'mem_mib':4096,'vcpus':1,'basis':'agent turns:4096MiB/1vCPU'}},'provenance':{'profile_id':'agent-turns-edit-v1','os_image_hash':osh}}
ir=canon(image);(t/'image-manifest.json').write_bytes(ir)
(t/'policy.json').write_bytes(canon({'schema':'dsmack-general-launcher/admission-policy/1','policy_id':'agent-turns-4096-1-900','notes':'agent turns',
 'admitted_images':[{'image_id':osh,'manifest_sha256':hashlib.sha256(ir).hexdigest(),'admitted_by':'local:agent-turns'}],
