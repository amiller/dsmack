#!/usr/bin/env python3
"""dsmack-agent run: hand a coding task on a git checkout to the pinned agent and get back a patch.

The working tree is snapshotted and sent with a dsmack-agent-turn/1 request to the attested Mac.
zed admits the attempt (mac.py admit), the Mac stages the subscription credential and runs it in the
signed release's guest, zed verifies the evidence, and turn.from_receipt reads the verified receipt.
"""
import argparse
import io
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tarfile
import uuid

TURNS = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(TURNS))
import find
import turn

CLI_VERSION, CLI_SHA256 = '2.1.187', 'b49be8a5e565bf2d45b50d2de62017b25462131acc9425d2fdb98b8f29c9dce2'
MAX_INPUTS = 16 << 20
ZED, ZED_DIR = 'zed-mesh', '/data/amiller/dsmack/mac-dispatch-20261025'
RELEASE, IMAGE = 'release-2', 'image-2'
MAC, MAC_DIR = 'mini-mesh', 'dsmack-mac-dispatch-20261025'
CREDENTIAL = '.dsmack/private-inputs/claude-subscription.json'
ADMITTED = 'workload.img workload-admission.json workload.sig closure-context.json checker-context.json challenge.bin keyId.txt preparation'

# On the Mac: stage the credential through the pipe, write the local task, prepare, check and launch once.
MAC_RUN = r'''set -euo pipefail
D=$HOME/$1; T=$D/t/$2; S=$D/source
# A launch consumes the attempt: refuse before it when the two 4 GiB scratch copies cannot fit or another VM runs.
[ "$(df -k "$D" | tail -1 | awk '{print $4}')" -gt 10485760 ] || { echo 'the Mac needs 10 GiB free' >&2; exit 3; }
! pgrep -f 'dsmack-runner hvf' >/dev/null || { echo 'another VM is running on the Mac' >&2; exit 3; }; W=$S/applications/pilot-client/workload; G=$S/base-vm/browser-sandbox-v1/source
cd "$T"; mkdir -m700 private tmp; mkdir -m700 -p $D/r
P=preparation; M=$(shasum -a 256 $P/compose-manifest.json | cut -d' ' -f1); J=$(shasum -a 256 $P/public-file-projection.json | cut -d' ' -f1)
python3 -I -B $W/export_subscription.py --source "$HOME/$3" --emit-credential-stdout | \
python3 -I -B $W/stage_private.py --preparation $P --expected-manifest-sha256 $M --expected-projection-sha256 $J \
  --guest-source $G --transport-module $G/smoke/launch_vm_dstack_arm64.py --private-parent $T/private --out-name turn \
  --transport-backend darwin-owned-tempfile-v1 --portable-module $W/portable.py --temporary-parent $T/tmp
python3 -I - "$T" <<'PY'
import hashlib,json,os,sys
from pathlib import Path
os.umask(0o077);t=Path(sys.argv[1])
pin=lambda n:{'path':str(t/n),'bytes':(t/n).stat().st_size,'sha256':hashlib.sha256((t/n).read_bytes()).hexdigest()}
task={'schema':'dsmack-alpha-local-task/3','profile_id':'agent-turns-edit-v1','private_input_path':str(t/'private/turn/private-input.img'),
 **{k:pin(n) for k,n in [('closure_context','closure-context.json'),('checker_context','checker-context.json'),('challenge','challenge.bin'),
 ('key_id','keyId.txt'),('workload_disk','workload.img'),('workload_admission','workload-admission.json'),('workload_signature','workload.sig')]}}
(t/'task.json').write_text(json.dumps(task,sort_keys=True,separators=(',',':')))
PY
C="python3 -I -B $D/installed/alpha_coordinator.py"
$C --prepare --bootstrap $D/bootstrap/bootstrap.json --inventory $D/release.json --signature $D/release.sig \
  --root $D/installed --profile agent-turns-edit-v1 --task $T/task.json --out-parent $D/r > prepare.json
PLAN=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["plan"])' prepare.json)
$C --check-only --plan $PLAN
$C --execute --plan $PLAN > execute.json
'''

def snapshot(repo, inputs):
    names = subprocess.run(['git', '-C', str(repo), 'ls-files', '-z', '-co', '--exclude-standard', '--deduplicate'],
                           check=True, capture_output=True).stdout.decode().split('\0')
    for name in filter(None, names):
        if os.path.lexists(repo/name):
            (inputs/name).parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(repo/name, inputs/name, follow_symlinks=False)
    size = sum(p.stat().st_size for p in inputs.rglob('*') if p.is_file())
    find.require(size <= MAX_INPUTS, f'snapshot is {size} bytes; the Mac projection limit is {MAX_INPUTS}')
    return find.tree_digest(inputs)


def ssh(host, command, **kw):
    return subprocess.run(['ssh', host, command], check=True, **kw)


def mac(request, inputs, out):
    """Run the turn in the signed release's guest on the Mac. Returns the verified receipt v4."""
    run_id = uuid.uuid4().hex[:12]
    zed = f'{ZED_DIR}/attempts/{run_id}'
    tree = io.BytesIO()
    with tarfile.open(fileobj=tree, mode='w', format=tarfile.USTAR_FORMAT) as tar:
        for path in sorted(p for p in inputs.rglob('*') if p.is_file()):
            tar.add(path, str(path.relative_to(inputs)))
    bundle = io.BytesIO()
    with tarfile.open(fileobj=bundle, mode='w') as tar:
        for name, raw in (('request.json', request), ('tree.tar', tree.getvalue())):
            info = tarfile.TarInfo(name)
            info.size = len(raw)
            tar.addfile(info, io.BytesIO(raw))
    ssh(ZED, f'mkdir -p {zed} && tar -x -C {zed}', input=bundle.getvalue())
    admitted = ssh(ZED, f'cd {ZED_DIR} && python3 -B source/applications/agent-turns/mac.py admit --release {RELEASE} '
                        f'--oci {IMAGE}/oci-layout --authority authority --request {zed}/request.json '
                        f'--inputs-tar {zed}/tree.tar --out {zed}/admit', capture_output=True).stdout
    attempt = json.loads(admitted.splitlines()[-1])['attempt_id']
    (out/'admission.json').write_bytes(admitted.splitlines()[-1])
    pipe(f'tar -c -C {zed}/admit {ADMITTED}', f'mkdir -m700 -p {MAC_DIR}/t/{run_id} && tar -x -C {MAC_DIR}/t/{run_id} && chmod -R go-rwx {MAC_DIR}/t/{run_id}')
    evidence = f'{MAC_DIR}/r/attempt-{attempt}'
    try:
        ssh(MAC, f'bash -s {MAC_DIR} {run_id} {CREDENTIAL}', input=MAC_RUN.encode())
        pipe(f'tar -c --exclude scratch.img --exclude "*.staged" -C {evidence} .', f'mkdir {zed}/evidence && tar -x -C {zed}/evidence', MAC, ZED)
    finally:
        # The VM has exited once execute returns; its two 4 GiB scratch copies are the run's only large residue.
        # private-input.img holds the credential.
        ssh(MAC, f'rm -rf {MAC_DIR}/t/{run_id}/private {MAC_DIR}/t/{run_id}/tmp {MAC_DIR}/t/{run_id}/workload.img; '
                 f'cd {evidence} && ! /usr/sbin/lsof -- scratch.img scratch-template.img.staged '
                 f'&& rm -f scratch.img *.staged')
    result = ssh(ZED, f'cd {ZED_DIR} && python3 -B source/applications/agent-turns/mac.py verify --authority authority '
                      f'--attempt {zed}/admit --evidence {zed}/evidence --job {zed}/verify', capture_output=True).stdout
    (out/'verification.json').write_bytes(result.splitlines()[-1])
    pulled = ssh(ZED, f'tar -c -C {zed}/verify/retained receipt.json report.json -C outputs artifacts', capture_output=True).stdout
    with tarfile.open(fileobj=io.BytesIO(pulled)) as tar:
        tar.extractall(out, filter='data')
    return json.loads((out/'receipt.json').read_bytes())


def pipe(source, sink, src=ZED, dst=MAC):
    """Stream a tar from one host to another through this machine."""
    reader = subprocess.Popen(['ssh', src, source], stdout=subprocess.PIPE)
    subprocess.run(['ssh', dst, sink], stdin=reader.stdout, check=True)
    assert reader.wait() == 0, f'{src}: {source}'


def run(args):
    repo, out = args.repo.resolve(), args.out.resolve()
    out.mkdir(parents=True)
    (out/'inputs').mkdir()
    agent = {'cli_version': CLI_VERSION, 'cli_sha256': CLI_SHA256,
             'model': args.model, 'tools': args.tools.split(','), 'max_turns': args.max_turns,
             'wall_seconds': args.wall_seconds, 'settings': {'disableAllHooks': True}}
    request = turn.canonical({'schema': 'dsmack-agent-turn/1', 'agent': agent, 'prompt': args.prompt,
                              'inputs_sha256': snapshot(repo, out/'inputs'), 'state_in': None})
    (out/'request.json').write_bytes(request)
    print('out:', out, file=sys.stderr)
    receipt = mac(request, out/'inputs', out)
    record = turn.from_receipt(receipt, request, out/'artifacts')
    (out/'turn.json').write_text(json.dumps(record, indent=2))
    patch = out/'artifacts'/'patch'
    subprocess.run(['git', '-C', str(repo), 'apply', '--check', str(patch)], check=True)
    print(patch)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(required=True)
    p = sub.add_parser('run', help='dispatch one coding turn')
    p.add_argument('--repo', type=Path, required=True, help='git checkout; its working tree is the input')
    p.add_argument('--prompt', required=True)
    p.add_argument('--out', type=Path, required=True, help='new local directory for the request and artifacts')
    p.add_argument('--tools', default='Read,Grep,Glob,Edit,Write')
    p.add_argument('--model', default='claude-opus-4-8')
    p.add_argument('--max-turns', type=int, default=30)
    p.add_argument('--wall-seconds', type=int, default=480)
    p.set_defaults(func=run)
    args = parser.parse_args()
    args.func(args)


if __name__ == '__main__':
    main()
