# Zed-only source recipe. All four complete logic ports require source/selected-image qualification.
# Build context: repository root. No install, download or candidate command.
ARG ADMITTED_BROWSER_IMAGE
FROM ${ADMITTED_BROWSER_IMAGE}
USER root
WORKDIR /opt/bounty-judges
COPY applications/bounty-judges/suite-contract.mjs applications/bounty-judges/browser-driver.mjs ./
COPY applications/bounty-judges/primary-*.mjs applications/bounty-judges/primary.config.mjs applications/bounty-judges/primary-logic-coverage.json ./
COPY applications/bounty-judges/primary-original/ ./primary-original/
COPY applications/bounty-recipes/board-search-pilot-v1/fixed-baseline/ ./fixed-baseline/
RUN chmod -R a+rX /opt/bounty-judges \
 && /usr/bin/node -e 'if(require("/opt/checker/node_modules/playwright/package.json").version!=="1.64.0")process.exit(2)'
USER 1000:1000
ENTRYPOINT ["/usr/bin/node", "/opt/bounty-judges/primary-driver.mjs"]
