# Same generic measured public-file channel; credential-free browser only.
ARG ADMITTED_BROWSER_IMAGE
FROM ${ADMITTED_BROWSER_IMAGE}
USER root
# First candidate resolves official Ubuntu packages; selected OCI/dpkg manifest
# is qualification authority, not an unproved reproducible-build claim.
RUN apt-get -o Acquire::Retries=3 -o Acquire::http::No-Cache=true update \
 && apt-get install -y --no-install-recommends python3=3.12.3-0ubuntu2.1 python3.12=3.12.3-1ubuntu0.17 libpython3.12-stdlib=3.12.3-1ubuntu0.17 \
 && mkdir -p /usr/share/dsmack \
 && dpkg-query -W > /usr/share/dsmack/python-runtime-dpkg.tsv \
 && find /var/lib/apt/lists -type f -exec sha256sum {} + > /usr/share/dsmack/python-runtime-apt-lists.sha256 \
 && apt-get clean && rm -rf /var/lib/apt/lists/*
# Native runner resolves harness through a symlink-free image path.
RUN cp -L /usr/bin/python3 /usr/bin/.dsmack-python3-regular \
 && chmod 0755 /usr/bin/.dsmack-python3-regular \
 && mv -T /usr/bin/.dsmack-python3-regular /usr/bin/python3 \
 && test ! -L /usr/bin/python3 \
 && /usr/bin/python3 -I -B -c "import argparse,hashlib,json,pathlib,stat,subprocess,tarfile"
COPY applications/bounty-runtime/entrypoint.py applications/bounty-runtime/audit_stage.py applications/bounty-runtime/source_bundle.py applications/bounty-runtime/project.py applications/bounty-runtime/observation.py applications/bounty-runtime/output_bundle.py applications/bounty-runtime/browser-launch.mjs applications/bounty-runtime/primary-launch.mjs applications/bounty-runtime/driver.py /opt/applications/bounty-runtime/
COPY applications/bounty-recipes/protocol.py /opt/applications/bounty-recipes/protocol.py
COPY applications/bounty-judges/ /opt/bounty-judges/
COPY applications/bounty-recipes/board-search-pilot-v1/fixed-baseline/ /opt/bounty-judges/fixed-baseline/
RUN test -z "$(find /opt/applications /opt/bounty-judges -name __pycache__ -o -name '*.pyc' -o -name '*.pyo' -o -name '*.so' -o -name '*.pyd' -o -name '*.pth')" \
 && find /opt/applications /opt/bounty-judges -type f -exec chmod 0444 {} + \
 && find /opt/applications /opt/bounty-judges -type d -exec chmod 0755 {} + \
 && test -x /usr/bin/node && test -x /usr/bin/python3 \
 && /usr/bin/python3 -I -B -c "import argparse,hashlib,json,pathlib,stat,subprocess,tarfile"
USER 1000:1000
ENTRYPOINT ["/usr/bin/python3", "-I", "-B"]
CMD ["/workspace/inputs/driver"]
