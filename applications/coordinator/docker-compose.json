{
 "services": {
  "coordinator": {
   "image": "dsmack-coordinator:local",
   "restart": "always",
   "ports": ["8080:8080"],
   "environment": {
    "OPERATOR_TOKEN": "${OPERATOR_TOKEN}",
    "API_KEY": "${API_KEY}",
    "RPC_URL": "${RPC_URL}",
    "CDREGISTRY": "${CDREGISTRY}"
   },
   "volumes": ["/var/run/dstack.sock:/var/run/dstack.sock", "state:/state"]
  }
 },
 "volumes": {"state": {}}
}
