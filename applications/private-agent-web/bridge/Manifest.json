{
  "bridgeVersion": 1,
  "globalObject": "window.dsmack",
  "injectedByApp": true,
  "methods": [
    {
      "name": "runtime.getCapabilities",
      "introducedVersion": 1,
      "parameters": {},
      "returns": "RuntimeSnapshot"
    },
    {
      "name": "storage.get",
      "introducedVersion": 1,
      "parameters": {
        "key": {
          "type": "string",
          "required": true
        }
      },
      "returns": "JSONValue | null"
    },
    {
      "name": "storage.put",
      "introducedVersion": 1,
      "parameters": {
        "key": {
          "type": "string",
          "required": true
        },
        "value": {
          "type": "JSONValue",
          "required": true
        }
      },
      "returns": "JSONValue"
    },
    {
      "name": "storage.list",
      "introducedVersion": 1,
      "parameters": {},
      "returns": "string[]"
    },
    {
      "name": "agent.complete",
      "introducedVersion": 1,
      "parameters": {
        "messages": {
          "type": "Array<{role: user | assistant, content: string}>",
          "required": true,
          "minItems": 1,
          "maxItems": 32,
          "maxTextBytes": 32768
        },
        "maxTokens": {
          "type": "integer",
          "required": false,
          "minimum": 64
        }
      },
      "returns": "{text: string, model: string, usage: object, evidence: object}"
    },
    {
      "name": "credit.balance",
      "introducedVersion": 1,
      "parameters": {},
      "returns": "{wallet: string | null, remainingNanoUsd: string, spentNanoUsd: string, pending: boolean}"
    },
    {
      "name": "diagnostics.log",
      "introducedVersion": 1,
      "parameters": {
        "message": {
          "type": "string",
          "required": true
        }
      },
      "returns": null
    }
  ],
  "events": [],
  "errors": [
    "INVALID_ARGS",
    "UNSUPPORTED_VERSION",
    "METHOD_NOT_FOUND",
    "NOT_AVAILABLE",
    "PERMISSION_DENIED",
    "USER_CANCELLED",
    "RATE_LIMITED",
    "GESTURE_REQUIRED",
    "TIMEOUT",
    "HOST_ERROR"
  ]
}
