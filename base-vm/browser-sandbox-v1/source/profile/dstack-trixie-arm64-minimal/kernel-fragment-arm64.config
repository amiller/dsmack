# dstack-derived minimal ARM64 guest kernel fragment.
# Provenance: arch-neutral subset of Dstack-TEE/dstack @ 247c3add65d0e8e6ba90eae5f6b981a9063cf701
# os/mkosi/components/kernel/kernel.config (values preserved where carried over;
# deltas marked DELTA below), applied on top of arm64 defconfig the way
# upstream applies kernel.config on top of x86_64_defconfig.
# Every line is an assertion: os check-kernel-config.sh (vendored) verifies the
# final .config matches, so a silently dropped/clamped symbol fails the build.

CONFIG_LOCALVERSION="-dstack"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_MODULES=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- guest device bus (QEMU -M virt + Apple Virtualization.framework virtio) ---
# DELTA upstream adds VIRTIO_PCI on x86; ARM64 needs VIRTIO_MMIO as well (the
# QEMU virt machine's default transport) and keeps PCI for virtio-net-pci.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y

# consoles: PL011 = QEMU -serial (early log capture); HVC = virtio console
# (hvc0, the Mac HVF boot contract this profile must keep).
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_HVC_DRIVER=y

CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

# --- dstack root integrity protocol: read-only squashfs + dm-verity ---
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_DM_BUFIO=y
CONFIG_EXT4_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y

# --- container runtime support (same feature set the foundation checkers
# require; DELTA built-in =y instead of upstream =m modules so the guest needs
# no initramfs module loading for the container stack) ---
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_METACOPY=y
CONFIG_CGROUPS=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_MEMCG=y
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
# defconfig keeps the NAT chain modular; the container stack needs it built in
# (NETFILTER_XTABLES=m / NF_CONNTRACK=m clamp every dependent to m).
CONFIG_NETFILTER_XTABLES=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
# the legacy ip_tables family (IP_NF_IPTABLES / IP_NF_FILTER / IP_NF_NAT /
# IP_NF_TARGET_MASQUERADE) was removed from the kernel before 6.18; filtering
# and NAT go through NF_TABLES + NF_NAT + the nft-era
# NETFILTER_XT_TARGET_MASQUERADE target (what docker's iptables-nft backend uses).
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NET_KEY=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_UNIX=y
CONFIG_PACKET=y

# entropy: the RANDOM_TRUST_CPU / RANDOM_TRUST_BOOTLOADER Kconfig symbols no
# longer exist in 6.18 (removed upstream), so the corresponding cmdline tokens
# are gone from this profile too — carrying inert tokens would silently claim
# a policy the kernel cannot implement. ARM64 entropy comes from RNDR on this
# platform's targets (Apple Silicon, QEMU -cpu max).

# DELTA upstream keeps DEBUG_INFO_BTF for in-guest BPF/introspection tooling;
# this minimal profile has none, so BTF is off (also sidesteps pahole
# encoder-order reproducibility; upstream serializes it when they build it).
CONFIG_DEBUG_INFO_BTF=n

# REPAIR (lane dstack-smoke-finish, 2026-10-20): the smoke of bundle
# 122c6e3a… failed deterministically — dockerd cannot create the default
# bridge network: iptables v1.8.11 (nf_tables) "Extension MASQUERADE revision 0
# not supported" + "CHAIN_ADD failed: chain POSTROUTING" because the nft NAT
# chain family was not compiled (NFT_NAT=n, NFT_MASQ=n, NFT_CT=n, NFT_COMPAT=n;
# the legacy x_tables backend is also absent). NETFILTER_XT_TARGET_MASQUERADE=y
# alone is NOT reachable through iptables-nft without NFT_COMPAT. Enable the
# nft-native pieces docker's iptables-nft backend actually exercises.
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_CT=y
CONFIG_NFT_COMPAT=y
